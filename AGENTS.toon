rules: "prefer_just_commands_for_build_check_test|never_edit_dist_directly|avoid_any_in_src_allow_boundary_casts_in_tests|no_try_catch_except_sync_fs_boundary|use_exact_log_markers_not_guesses"

build:
  cmd: "just build"
  check: "just check"
  clean: "just clean"

test:
  unit: "just test"
  heuristic: "just test-heuristic"
  plugin: "just test-plugin"
  ci: "just ci"
  benchmark: "just bench"
  demo: "just demo"
  manual: "run opencode in repo root; confirm stderr contains one of: service=agents-toon loaded:|service=agents-toon reload:|service=agents-toon no AGENTS.toon found"
  on_fail: "type_errors->just check|plugin_hook_cache_lookup->just test-plugin|heuristic_format_score->just test-heuristic"

plugin:
  hook: "experimental.chat.system.transform"
  hook_sig: "(input: {sessionID?: string, model: Model}, output: {system: string[]}) => Promise<void>"
  lookup: "directory/AGENTS.toon -> fallback worktree/AGENTS.toon|first match wins"
  injected: "Instructions from: <path>\\n<body>"
  cache: "stat(mtime+size) -> SHA-256 -> memory"
  cache_rule: "do_not_simplify|keep 2-stage stat+hash|do not collapse to hash-only"
  deletion_rule: "if file deleted after startup keep serving cached content"

paths:
  entry: "src/index.ts"
  heuristic: "src/heuristic.ts"
  command: "commands/evaluate-toon.md"
  plugin_test: "tests/plugin.test.ts"
  heuristic_test: "tests/heuristic.test.ts"

artifacts:
  dist: "generated by bun tsc|included in npm package|never edit directly"
  pre_commit: "pre-commit hook runs just build and stages dist/"

workflow:
  edit_plugin: "src/index.ts -> just check -> just test-plugin -> restart opencode"
  edit_heuristic: "src/heuristic.ts -> just check -> just test-heuristic"
